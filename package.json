{
  "name": "eslint-config-gluons",
  "version": "6.1.0",
  "description": "Gluons' personal ESLint shareable config.",
  "type": "module",
  "main": "index.js",
  "typings": "index.d.ts",
  "files": [
    "rules",
    "esnext.js",
    "esnext.d.ts",
    "index.js",
    "index.d.ts",
    "mixed.js",
    "mixed.d.ts",
    "ts.js",
    "ts.d.ts",
    "vue.js",
    "vue.d.ts",
    "vue-ts.js",
    "vue-ts.d.ts"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "del-cli ./*.{js,d.ts}",
    "prebuild": "npm run clean",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{json,ts,js,vue}\"",
    "pretest": "npm run build",
    "test": "jest",
    "posttest": "npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluons/eslint-config-gluons.git"
  },
  "keywords": [
    "❤️",
    "eslint",
    "eslintconfig",
    "gluons"
  ],
  "author": "Saran Tanpituckpong <sarunta@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gluons/eslint-config-gluons/issues"
  },
  "homepage": "https://gluons.github.io/eslint-config-gluons/",
  "prettier": "@gluons/prettier-config",
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.1",
    "@babel/preset-env": "^7.26.1",
    "@babel/preset-typescript": "^7.26.1",
    "@eslint/js": "^9.34.0",
    "@gluons/prettier-config": "^3.0.0",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "del-cli": "^6.0.0",
    "eslint": "^9.34.0",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "jest": "^30.0.5",
    "prettier": "^3.6.2",
    "tsconfig-gluons": "^1.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vue": "^3.5.19"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint-plugin-vue": "^10.4.0"
  },
  "packageManager": "yarn@4.9.3"
}
