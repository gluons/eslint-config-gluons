{
  "name": "eslint-config-gluons",
  "version": "7.0.0-beta.2",
  "description": "Gluons' personal ESLint shareable config.",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./ts": "./dist/ts.js",
    "./vue": "./dist/vue.js",
    "./vue-ts": "./dist/vue-ts.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "clean": "del-cli dist/",
    "build": "npm run clean && tsc",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "test": "npm run build && cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluons/eslint-config-gluons.git"
  },
  "keywords": [
    "❤️",
    "eslint",
    "eslintconfig",
    "gluons"
  ],
  "author": "Saran Tanpituckpong <sarunta@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gluons/eslint-config-gluons/issues"
  },
  "homepage": "https://gluons.github.io/eslint-config-gluons/",
  "prettier": "@gluons/prettier-config",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@gluons/prettier-config": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.8",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "oxlint-tsgolint": "^0.11.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vue": "^3.5.26"
  },
  "peerDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "optionalDependencies": {
    "eslint-plugin-vue": "^10.6.2",
    "typescript-eslint": "^8.53.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "packageManager": "yarn@4.14.1"
}
