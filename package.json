{
  "name": "eslint-config-gluons",
  "version": "6.1.0",
  "description": "Gluons' personal ESLint shareable config.",
  "type": "module",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "clean": "del-cli ./*.{js,d.ts}",
    "prebuild": "npm run clean",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{json,ts,js,vue}\"",
    "pretest": "npm run build",
    "test": "jest",
    "posttest": "npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluons/eslint-config-gluons.git"
  },
  "keywords": [
    "❤️",
    "eslint",
    "eslintconfig",
    "gluons"
  ],
  "author": "Saran Tanpituckpong <sarunta@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gluons/eslint-config-gluons/issues"
  },
  "homepage": "https://gluons.github.io/eslint-config-gluons/",
  "prettier": "@gluons/prettier-config",
  "dependencies": {
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.38.0",
    "@gluons/prettier-config": "^3.0.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.38.0",
    "eslint-config-xo": "^0.49.0",
    "eslint-config-xo-typescript": "^9.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vue": "^3.5.22"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "optionalDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint-plugin-vue": "^10.5.1"
  },
  "packageManager": "yarn@4.9.3"
}
