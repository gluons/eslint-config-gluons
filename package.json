{
  "name": "eslint-config-gluons",
  "version": "7.0.0-beta.3",
  "description": "Gluons' personal ESLint shareable config.",
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./ts": "./dist/ts.js",
    "./vue": "./dist/vue.js",
    "./vue-ts": "./dist/vue-ts.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "prepack": "npm run build",
    "clean": "del-cli dist/",
    "build": "npm run clean && tsc",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "test": "npm run build && cross-env NODE_OPTIONS=\"--experimental-vm-modules --no-warnings\" jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gluons/eslint-config-gluons.git"
  },
  "keywords": [
    "❤️",
    "eslint",
    "eslintconfig",
    "gluons"
  ],
  "author": "Saran Tanpituckpong <sarunta@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gluons/eslint-config-gluons/issues"
  },
  "homepage": "https://gluons.github.io/eslint-config-gluons/",
  "prettier": "@gluons/prettier-config",
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gluons/prettier-config": "^3.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "cross-env": "^10.1.0",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0"
  },
  "optionalDependencies": {
    "eslint-plugin-vue": "^10.10.0",
    "typescript-eslint": "^8.66.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "yarn@4.18.0"
}
