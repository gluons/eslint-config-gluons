{
	"compilerOptions": {
		"module": "es2015",
		"moduleResolution": "bundler",
		"target": "es2022",
		"sourceMap": false,
		"declaration": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"outDir": "./dist"
	},
	"include": ["src"],
	"exclude": []
}
